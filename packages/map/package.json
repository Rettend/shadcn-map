{
  "name": "shadcn-map",
  "version": "0.2.5",
  "description": "A minimal, fast map library for Svelte 5 and Solid built on MapLibre GL with shadcn aesthetics.",
  "keywords": [
    "map",
    "maplibre",
    "maplibre-gl",
    "shadcn",
    "solid-js",
    "svelte",
    "svelte-5"
  ],
  "homepage": "https://github.com/Rettend/shadcn-map#readme",
  "bugs": {
    "url": "https://github.com/Rettend/shadcn-map/issues"
  },
  "license": "MIT",
  "author": "Hegyi Áron Ferenc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rettend/shadcn-map.git",
    "directory": "packages/map"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/svelte/index.d.ts",
  "svelte": "./dist/svelte/index.js",
  "exports": {
    ".": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./styles": {
      "types": "./dist/shared/styles/index.d.ts",
      "default": "./dist/shared/styles/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "solid": "./dist/solid/index.jsx"
    },
    "./solid.css": {
      "default": "./dist/solid/index.css"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "lint": "vp lint",
    "check": "svelte-check --tsconfig ./tsconfig.json && bun run check:solid",
    "check:solid": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.solid.json",
    "test": "bun test src/shared && bun run test:solid",
    "test:solid": "bun --conditions=browser --conditions=development test src/solid"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0",
    "pmtiles": "^4.5.0",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.14",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/geojson": "^7946.0.16",
    "solid-js": "2.0.0-rc.14",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.14",
    "solid-js": "^2.0.0-rc.14",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.2"
}
