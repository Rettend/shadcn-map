{
  "name": "shadcn-map",
  "type": "module",
  "version": "0.1.6",
  "description": "A minimal, fast, dark map library for Svelte 5 built on MapLibre GL and shadcn-svelte aesthetics.",
  "author": "Hegyi Áron Ferenc",
  "license": "MIT",
  "homepage": "https://github.com/Rettend/shadcn-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rettend/shadcn-map.git",
    "directory": "packages/map"
  },
  "bugs": {
    "url": "https://github.com/Rettend/shadcn-map/issues"
  },
  "keywords": [
    "svelte",
    "svelte-5",
    "map",
    "maplibre",
    "maplibre-gl",
    "shadcn"
  ],
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "dev": "svelte-package -i src -w",
    "build": "svelte-package -i src",
    "lint": "eslint . --fix",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "release": "bumpp && bun run build && bun publish"
  },
  "peerDependencies": {
    "mode-watcher": "^1.0.0",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^4.1.0",
    "supercluster": "^8.0.1",
    "unocss-merge": "^0.7.3",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.11",
    "@sveltejs/vite-plugin-svelte": "^6.0.10",
    "@types/geojson": "^7946.0.16",
    "@types/supercluster": "^7.1.3",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
